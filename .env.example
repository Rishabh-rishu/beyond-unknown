# ==========================================
# BEYOND UNKNOWN - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini AI Engine
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# 2. Visual Assets (Optional - fallback to Wikimedia, NASA & Procedural graphics)
# Get free API key from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# 3. YouTube Data API v3 & OAuth2
# Set up in Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# 4. Voiceover & Production Settings
VOICE_NAME=hi-IN-MadhurNeural
VOICE_RATE=+15%
AUDIO_TEMPO=1.15

# 5. Scheduling & Timezone
TIMEZONE=Asia/Kolkata
MORNING_PUBLISH_TIME=09:30
EVENING_PUBLISH_TIME=17:30
SCHEDULING_BUFFER_MINUTES=45
